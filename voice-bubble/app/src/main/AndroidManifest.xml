<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only used to download the speech model once. Your voice never leaves the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Optional: lets it see which app is open, to pick the right writing style. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />

    <!-- Apps whose icons are shown on the Styles screen, and Claude for the import helper. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.samsung.android.messaging" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.thunderdog.challegram" />
        <package android:name="com.facebook.orca" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.instagram.android" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.discord" />
        <package android:name="jp.naver.line.android" />
        <package android:name="com.viber.voip" />
        <package android:name="com.facebook.mlite" />
        <package android:name="com.instagram.barcelona" />
        <package android:name="com.Slack" />
        <package android:name="com.microsoft.teams" />
        <package android:name="com.google.android.apps.dynamite" />
        <package android:name="us.zoom.videomeetings" />
        <package android:name="com.mattermost.rn" />
        <package android:name="com.webex.meetings" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.microsoft.office.outlook" />
        <package android:name="com.samsung.android.email.provider" />
        <package android:name="ch.protonmail.android" />
        <package android:name="com.yahoo.mobile.client.android.mail" />
        <package android:name="com.readdle.spark" />
        <package android:name="com.fsck.k9" />
        <package android:name="net.thunderbird.android" />
        <package android:name="com.superhuman.mail" />
        <package android:name="com.anthropic.claude" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="Voice Bubble"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ImportActivity"
            android:exported="true"
            android:label="Import to Voice Bubble"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- Share a screenshot (or a list) of another app's dictionary straight to Voice Bubble. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity android:name=".DictionaryActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ShortcutsActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".ModelActivity" android:exported="false" />

        <activity
            android:name=".StylesActivity"
            android:exported="false" />

        <activity
            android:name=".StartBubbleActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".BubbleTile"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="Voice Bubble"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>

        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
